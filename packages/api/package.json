{
  "name": "@acme/api",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./types/generated-routes-frontend.ts"
    }
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "generate:frontend-routes": "node ./scripts/generate-frontend-routes.mjs",
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/client-sqs": "^3.1026.0",
    "@aws-sdk/lib-storage": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@medusajs/admin-sdk": "2.13.4",
    "@medusajs/admin-shared": "2.13.4",
    "@medusajs/cli": "2.13.4",
    "@medusajs/dashboard": "2.13.4",
    "@medusajs/draft-order": "2.13.4",
    "@medusajs/framework": "2.13.4",
    "@medusajs/medusa": "2.13.4",
    "@mercurjs/cli": "2.0.0",
    "@mercurjs/core-plugin": "2.0.0",
    "@mercurjs/types": "2.0.0",
    "@mikro-orm/knex": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "axios": "^1.14.0",
    "axios-retry": "^4.5.0",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "date-fns": "^3.6.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "multer": "^1.4.5-lts.2",
    "razorpay": "^2.9.6",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "^2.13.4",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
